{
  "name": "@autocut-cli/llm-wiki",
  "version": "0.1.1",
  "description": "A local, citation-aware LLM Wiki builder with a single-tool MCP interface.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TigerOfCountryYao/llm-wiki-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/TigerOfCountryYao/llm-wiki-mcp/issues"
  },
  "homepage": "https://github.com/TigerOfCountryYao/llm-wiki-mcp#readme",
  "keywords": [
    "llm",
    "wiki",
    "mcp",
    "model-context-protocol",
    "knowledge-base",
    "codebase"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "llm-wiki": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "llm-wiki-compiler": "npm:@autocut-cli/llm-wiki-compiler@1.1.0-autocut.1",
    "zod": "4.4.3"
  },
  "optionalDependencies": {
    "@github/keytar": "7.10.6"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
